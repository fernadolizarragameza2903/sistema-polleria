# ============================================================
#  Backend - Sistema Pollería Paukeñito
#  Copia este archivo como .env (local) o carga estas variables
#  en Render > Web Service > Environment.
# ============================================================

# --- Servidor ---
# Render asigna PORT automáticamente; en local se usa 3001.
PORT=3001
NODE_ENV=production
# Zona horaria del proceso Node (Render corre en UTC por defecto).
TZ=America/Lima
# Zona horaria del negocio para reportes (Perú, sin horario de verano).
TZ_NEGOCIO=-05:00
# Orígenes permitidos por CORS: * (público) o la URL del frontend,
# p. ej. https://polleria-web.onrender.com (varias separadas por coma).
CORS_ORIGIN=*

# --- Autenticación ---
# Cadena larga y aleatoria. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=24h

# --- Base de datos MySQL (Aiven.io u otro proveedor) ---
# Datos de Aiven > tu servicio MySQL > Overview > Connection information
MYSQL_HOST=mysql-xxxxxxxx-tuproyecto.d.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=polleria_db
# Aiven exige SSL. En local con XAMPP usa MYSQL_SSL=false.
MYSQL_SSL=true
# (Opcional, recomendado) Contenido del certificado CA de Aiven (ca.pem) para
# verificar el servidor. En Render pega el texto completo del archivo, incluyendo
# las líneas -----BEGIN CERTIFICATE----- y -----END CERTIFICATE-----.
MYSQL_CA_CERT=
# Conexiones simultáneas máximas (el plan gratuito de Aiven tiene un límite bajo).
MYSQL_POOL_MAX=5
